{
  "_fragment": {
    "name": "qwen-image-sampler",
    "description": "Qwen Image 2.1 style sampler, derived from the official T2I workflow; direct style prompt, no prompt rewriting.",
    "terminal": true,
    "source": "https://github.com/Comfy-Org/workflow_templates/blob/main/templates/image_qwen_image_2_1_t2i.json",
    "inputs": {},
    "outputs": {},
    "params": {
      "load_diffusion_model_unet_name": {
        "type": "STRING",
        "binds": "2.unet_name"
      },
      "load_diffusion_model_weight_dtype": {
        "type": "STRING",
        "binds": "2.weight_dtype",
        "default": "default"
      },
      "text_encode_qwen_image_2_1_negative_prompt": {
        "type": "STRING",
        "binds": "3.negative_prompt",
        "default": ""
      },
      "text_encode_qwen_image_2_1_resolution": {
        "type": "INT",
        "binds": "3.resolution",
        "default": 1024
      },
      "load_clip_clip_name": {
        "type": "STRING",
        "binds": "4.clip_name"
      },
      "load_clip_type": {
        "type": "STRING",
        "binds": "4.type",
        "default": "qwen_image"
      },
      "load_clip_device": {
        "type": "STRING",
        "binds": "4.device",
        "default": "default"
      },
      "load_vae_vae_name": {
        "type": "STRING",
        "binds": "5.vae_name"
      },
      "empty_latent_image_batch_size": {
        "type": "INT",
        "binds": "6.batch_size",
        "default": 1
      },
      "ksampler_seed": {
        "type": "INT",
        "binds": "8.seed",
        "default": 0
      },
      "ksampler_steps": {
        "type": "INT",
        "binds": "8.steps",
        "default": 25
      },
      "ksampler_cfg": {
        "type": "INT",
        "binds": "8.cfg",
        "default": 1
      },
      "ksampler_sampler_name": {
        "type": "STRING",
        "binds": "8.sampler_name",
        "default": "euler"
      },
      "ksampler_scheduler": {
        "type": "STRING",
        "binds": "8.scheduler",
        "default": "simple"
      },
      "ksampler_denoise": {
        "type": "INT",
        "binds": "8.denoise",
        "default": 1
      },
      "qwen_image_2_1_cache_device": {
        "type": "STRING",
        "binds": "14.device",
        "default": "auto"
      },
      "qwen_image_2_1_cache_dtype": {
        "type": "STRING",
        "binds": "14.dtype",
        "default": "default"
      },
      "prompt": {
        "type": "STRING",
        "binds": "20.value",
        "default": "style sample"
      },
      "width": {
        "type": "INT",
        "binds": "21.value",
        "default": 512
      },
      "height": {
        "type": "INT",
        "binds": "22.value",
        "default": 512
      },
      "filename_prefix": {
        "type": "STRING",
        "binds": "23.value",
        "default": "samples/qwen_sample"
      }
    }
  },
  "2": {
    "inputs": {
      "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
      "weight_dtype": "default"
    },

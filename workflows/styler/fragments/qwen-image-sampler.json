      "title": "VAE Decode"
    }
  },
  "8": {
    "inputs": {
      "seed": 0,
      "steps": 25,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": [
        "14",
        0
      ],
      "positive": [
        "3",
        0
      ],
      "negative": [
        "3",
        1
      ],
      "latent_image": [
        "6",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "14": {
    "inputs": {
      "device": "auto",
      "dtype": "default",
      "model": [
        "2",
        0
      ]
    },
    "class_type": "QwenImage21Cache",
    "_meta": {
      "title": "Qwen Image 2.1 Cache"
    }
  },
  "20": {
    "class_type": "PrimitiveStringMultiline",
    "inputs": {
      "value": "style sample"
    },
    "_meta": {
      "title": "PROMPT"
    }
  },
  "21": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": 512
    },
    "_meta": {
      "title": "WIDTH"
    }
  },
  "22": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": 512
    },
    "_meta": {
      "title": "HEIGHT"
    }
  },
  "23": {
    "class_type": "PrimitiveString",
    "inputs": {
      "value": "samples/qwen_sample"
    },
    "_meta": {
      "title": "FILENAME_PREFIX"
    }
  },
  "24": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "7",
        0
      ],
      "filename_prefix": [
        "23",
        0
      ]
    }
  }
